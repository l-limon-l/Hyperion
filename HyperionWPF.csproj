<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HyperionWPF</RootNamespace>
    <AssemblyName>Hyperion</AssemblyName>
    <ApplicationIcon>hyperion.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Version>2.0.0</Version>
    <Company>Hyperion</Company>
    <Product>Hyperion</Product>
    <Description>Batch installer for Windows software, driven by winget, scoop and Chocolatey.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The catalogue generator is Python; it must not reach the C# compiler. -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Icons\**\*.png" />
    <Resource Include="hyperion.ico" />
  </ItemGroup>

</Project>
