<Window x:Class="HyperionWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Hyperion" Height="880" Width="1220"
        MinHeight="620" MinWidth="960"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Icon="hyperion.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="{StaticResource TitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="hyperion.ico" Width="16" Height="16" Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Hyperion" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinBtn" Content="&#xE921;" Click="MinBtn_Click"
                        Style="{StaticResource TitleBarBtnStyle}"/>
                <Button x:Name="MaxBtn" Content="&#xE922;" Click="MaxBtn_Click"
                        Style="{StaticResource TitleBarBtnStyle}"/>
                <Button x:Name="CloseBtn" Content="&#xE8BB;" Click="CloseBtn_Click"
                        Style="{StaticResource TitleBarCloseBtnStyle}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="288"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Grid.Column="0" Background="{StaticResource NavBgBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,18,20,12">
                        <TextBlock Text="Hyperion" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="SubtitleText" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>

                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top"
                             Margin="16,0,16,12"
                             Style="{StaticResource SearchBoxStyle}"
                             TextChanged="SearchBox_TextChanged"/>

                    <!-- Selection summary and the primary action stay pinned to the bottom -->
                    <Grid DockPanel.Dock="Bottom" Margin="16,10,16,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ProgressBar x:Name="InstallProgress" Grid.Row="0"
                                     Style="{StaticResource SlimProgressBarStyle}"
                                     Margin="0,0,0,10"
                                     Visibility="Collapsed"/>

                        <Button x:Name="InstallBtn" Grid.Row="1"
                                Style="{StaticResource AccentButtonStyle}"
                                Height="40"
                                Click="InstallBtn_Click"/>

                        <Button x:Name="CancelBtn" Grid.Row="2"
                                Style="{StaticResource GhostButtonStyle}"
                                Height="30" Margin="0,8,0,0"
                                Visibility="Collapsed"
                                Click="CancelBtn_Click"/>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Style="{StaticResource DarkScrollViewer}">
                        <ListBox x:Name="NavList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="NavList_SelectionChanged"
                                 Padding="0,2,0,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItemStyle}"/>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Page header: title, how many are selected here, bulk actions -->
                <Grid Grid.Row="0" Margin="28,22,24,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="PageHint" FontSize="12" Margin="0,3,0,0"
                                   TextWrapping="Wrap" MaxWidth="620"
                                   HorizontalAlignment="Left"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>

                    <Button x:Name="SelectAllBtn" Grid.Column="1"
                            Style="{StaticResource GhostButtonStyle}"
                            VerticalAlignment="Center" Margin="12,0,6,0"
                            Click="SelectAllBtn_Click"/>
                    <Button x:Name="ClearAllBtn" Grid.Column="2"
                            Style="{StaticResource GhostButtonStyle}"
                            VerticalAlignment="Center"
                            Click="ClearAllBtn_Click"/>
                </Grid>

                <ScrollViewer x:Name="MainScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="28,0,16,0"
                              Style="{StaticResource DarkScrollViewer}">
                    <StackPanel x:Name="ContentPanel" Margin="0,0,8,20"/>
                </ScrollViewer>

                <!-- Log dock -->
                <DockPanel Grid.Row="2" Margin="28,10,24,16">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusInstalled" Foreground="{StaticResource SuccessBrush}"
                                       FontSize="12" Margin="0,0,16,0"/>
                            <TextBlock x:Name="StatusAlready" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" Margin="0,0,16,0"/>
                            <TextBlock x:Name="StatusErrors" Foreground="{StaticResource DangerBrush}"
                                       FontSize="12"/>
                        </StackPanel>
                        <Button x:Name="ClearLogBtn" Grid.Column="1" Content="&#xE74D;"
                                Click="ClearLogBtn_Click"
                                Style="{StaticResource ToolButtonStyle}" Margin="0,0,4,0"/>
                        <Button x:Name="SaveLogBtn" Grid.Column="2" Content="&#xE792;"
                                Click="SaveLogBtn_Click"
                                Style="{StaticResource ToolButtonStyle}"/>
                    </Grid>

                    <Border Background="{StaticResource LogBgBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBox x:Name="LogBox"
                                 Height="118"
                                 Background="Transparent"
                                 Foreground="{StaticResource LogFgBrush}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                                 IsReadOnly="True"
                                 IsReadOnlyCaretVisible="False"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0"
                                 TextWrapping="Wrap"
                                 Padding="12,10"
                                 SelectionBrush="{StaticResource AccentBrush}"
                                 CaretBrush="{StaticResource LogFgBrush}"/>
                    </Border>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
